# Postgres connection string.
# Local docker (see docker-compose.yml):
DATABASE_URL="postgres://tracker:tracker@localhost:5432/progresstracker"
# Hosted (Neon / Supabase / Railway) — remember ?sslmode=require

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Set to "true" to allow the very first account to be created without an
# invite code. Turn it off again once you have registered.
ALLOW_BOOTSTRAP_SIGNUP="true"
